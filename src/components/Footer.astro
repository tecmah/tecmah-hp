---
// Footer component - Stripe-inspired design
//
// リンクと会社情報は src/data/content.ts を単一ソースとして描画する。
// ここにハードコードすると content.ts と二重管理になり、どちらが実体か分からなくなる。
//
// 会社情報セクションの「電子公告」リンクは会社法上の公告到達性を担保する法的に効く導線。
// 登記した公告URL（tecmah.com トップ）から /koukoku → 各公告ページへ辿れる必要がある。
// content.ts の footer.sections.company.links から削除・改名しないこと
// （scripts/verify-koukoku.mjs がビルド後に全ページで検証する）。
import { company, footer } from "../data/content";

const footerSections = [footer.sections.services, footer.sections.company];
---

<footer class="site-footer">
  <div class="footer-gradient"></div>
  <div class="container">
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-brand">
        <div class="brand-logo">
          <span class="brand-name">TECMAH</span>
        </div>
        <p class="brand-description">
          {company.tagline}を行うスタートアップ。
          {footer.description}
        </p>
        <div class="brand-contact">
          <p>{company.address.full}</p>
          <p>Email: <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a></p>
        </div>
      </div>

      {footerSections.map((section) => (
        <div class="footer-links">
          <h4 class="footer-title">{section.title}</h4>
          <ul>
            {section.links.map((link) => (
              <li><a href={link.href}>{link.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bottom">
      <p>{footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--background-dark);
    color: var(--text);
    padding: 4rem 0 2rem;
    overflow: hidden;
  }

  .footer-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--primary), var(--secondary), transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-brand {
    max-width: 400px;
  }

  .brand-logo {
    margin-bottom: 1rem;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 800;
    background: var(--gradient-secondary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-description {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .brand-contact {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .brand-contact a {
    color: var(--primary);
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .brand-contact a:hover {
    color: var(--primary-light);
  }

  .footer-links h4.footer-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.75rem;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.9375rem;
    transition: color var(--motion-duration) var(--motion-ease);
    position: relative;
  }

  .footer-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--primary);
    transition: width var(--motion-duration) var(--motion-ease);
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-links a:hover::after {
    width: 100%;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
