---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';

const chartIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`;

// 会社の沿革タイムライン（2025年）
const milestones2025 = [
  {
    date: "2025年7月14日",
    title: "株式会社TECMAH設立",
    description: "北海道札幌市を拠点に、AI・データ活用とプロダクトマネジメント支援を専門とする法人を設立。",
    type: "major"
  },
  {
    date: "2025年8月",
    title: "創業手続き完了",
    description: "法人登記、税務届出、社会保険手続き等の創業事務を完了。freeeによる会計基盤を構築。",
    type: "normal"
  },
  {
    date: "2025年9月",
    title: "初の法人案件決定",
    description: "Findy経由でBAKUTAN株式会社からPM/PdM案件を受注。AIのPoC、人事領域のAI化プロジェクトに参画。",
    type: "major"
  },
  {
    date: "2025年10月",
    title: "法人案件稼働開始",
    description: "BAKUTAN案件にてフルコミット稼働（月間158時間）を開始。法人として初の売上を計上。",
    type: "normal"
  },
  {
    date: "2025年11月",
    title: "安定稼働体制へ移行",
    description: "案件が安定稼働（週24時間程度）に移行。新規事業への投資時間確保に向けた体制を構築。",
    type: "normal"
  },
  {
    date: "2025年12月",
    title: "IR情報公開開始",
    description: "投資家向け情報ページを公開。事業計画・財務情報の透明性を確保。",
    type: "normal"
  }
];

// 財務データ（詳細）
const financialData = {
  period: "2025年7月〜12月（第1期上半期）",
  revenue: {
    total: "132.3万円",
    note: "（予定入金含む）",
    breakdown: [
      { label: "BAKUTAN案件（10月稼働分）", value: "88.9万円", note: "入金: 11月末" },
      { label: "BAKUTAN案件（11月稼働分）", value: "44.5万円", note: "入金: 12月末" }
    ]
  },
  expenses: {
    monthly: "約29万円",
    total: "116.3万円",
    note: "（7-10月実績）",
    breakdown: [
      { label: "役員報酬", value: "40万円" },
      { label: "給料手当", value: "22.8万円" },
      { label: "減価償却費", value: "14.8万円" },
      { label: "法定福利費", value: "5.7万円" },
      { label: "その他経費", value: "33万円" }
    ]
  },
  profit: {
    operating: "-116.3万円",
    note: "（7-10月実績、投資フェーズ）"
  },
  cash: {
    current: "174.8万円",
    note: "（10月末時点）",
    forecast: "約280万円",
    forecastNote: "（12月末見通し）"
  },
  capital: {
    equity: "100万円",
    debt: "200万円",
    debtSource: "日本政策金融公庫"
  }
};

// 案件詳細
const projectDetails = {
  name: "BAKUTAN株式会社",
  role: "PM/PdM（プロダクトマネージャー）",
  description: "AIのPoC開発、人事領域のAI化・業務報告システム、スキル可視化アプリケーションのPoC",
  hourlyRate: "5,000円（税抜）",
  channel: "Findy経由",
  workload: [
    { month: "10月", hours: "158時間", note: "フルコミット" },
    { month: "11月", hours: "79時間", note: "半分稼働（週24時間）" }
  ]
};

// 2026年目標（詳細）
const targets2026 = {
  revenue: {
    monthly: "50万円",
    annual: "600万円"
  },
  profit: {
    monthly: "20万円",
    annual: "240万円"
  },
  expenses: {
    q1q2: "29万円/月",
    q3q4: "35万円/月"
  },
  quarterly: [
    { quarter: "Q1", revenue: "150万円", profit: "60万円", note: "BAKUTAN案件継続（月約44.5万円）を前提" },
    { quarter: "Q2", revenue: "150万円", profit: "60万円", note: "新規事業基盤確立" },
    { quarter: "Q3", revenue: "150万円", profit: "45万円", note: "教育コンテンツ事業開始" },
    { quarter: "Q4", revenue: "150万円", profit: "45万円", note: "自動化サイクル本格稼働" }
  ]
};

// 時間配分ルール
const timeAllocation = {
  maxWeekly: "45h/週",
  categories: [
    { 
      name: "Cash（現金調達）", 
      hours: "25h/週", 
      description: "法人・個人の受託案件（BAKUTAN, Kodato等）",
      color: "var(--primary)"
    },
    { 
      name: "Build（新規事業）", 
      hours: "15h/週", 
      description: "自動化サイクル構築（n8n/Dify/発信基盤/MVP）",
      color: "var(--accent)"
    },
    { 
      name: "Ops（維持）", 
      hours: "5h/週", 
      description: "経理/事務/障害対応/レビュー",
      color: "var(--text-muted)"
    }
  ],
  rules: [
    "週の総稼働上限を超える計画は禁止",
    "Buildの時間が不足するなら、Cashを削る",
    "Opsは最小を割らない（詰むので）"
  ]
};

// 成長戦略
const growthStrategy = {
  vision: "情報を資産化し、教育で回収し、M&Aで拡大する完全自動化サイクル",
  phases: [
    {
      phase: "Phase 1",
      period: "2025-2026",
      title: "情報収集基盤構築期",
      status: "current",
      kpis: ["monthly_articles", "followers", "engagement_rate"],
      initiatives: [
        "n8n/Difyによる自動情報収集システム構築",
        "コンテンツ発信基盤の確立",
        "AI関連ブログ・SNS投稿の自動化"
      ],
      whyWin: "自動化により低コストで大量の知的資産を積み上げる"
    },
    {
      phase: "Phase 2",
      period: "2027-2028",
      title: "教育コンテンツ事業期",
      status: "future",
      kpis: ["courses", "education_revenue", "retention_rate"],
      initiatives: [
        "教育コンテンツ量産（Udemy/Kindle/Note）",
        "有料講座・書籍のリリース",
        "収益の複線化"
      ],
      whyWin: "コンテンツ→教育→M&Aの循環により資産回収が複線化"
    },
    {
      phase: "Phase 3",
      period: "2028-2029",
      title: "M&A事業開始期",
      status: "future",
      kpis: ["ma_deals", "take_rate", "avg_deal_size"],
      initiatives: [
        "小規模M&A案件の実行",
        "デューデリジェンス・評価の自動化",
        "PMIテンプレートの確立"
      ],
      whyWin: "仲介ではなく、評価/運用の自動化を武器に差別化"
    },
    {
      phase: "Phase 4",
      period: "2029-2030",
      title: "M&A自動化拡大期",
      status: "future",
      kpis: ["ma_deals", "automation_rate", "operating_profit"],
      initiatives: [
        "自動化M&Aプラットフォーム完成",
        "ポートフォリオ運用の本格化",
        "再現性のある獲得・運用モデル確立"
      ],
      whyWin: "プラットフォーム化により限界コストを下げスケール"
    },
    {
      phase: "Phase 5",
      period: "2030-2035",
      title: "投資・ホールディングス期",
      status: "future",
      kpis: ["investment_irrs", "portfolio_companies", "cash_buffer_months"],
      initiatives: [
        "投資活動中心の事業構成へ移行",
        "資本配分の最適化",
        "複数事業の統合とシナジー最大化"
      ],
      whyWin: "知的資産循環で回収ルートを複線化し持続的成長"
    }
  ]
};

// 10年財務シナリオ
const financialScenarios = [
  { year: "2026", bear: "1,000万円", base: "3,000万円", bull: "5,000万円" },
  { year: "2030", bear: "5,000万円", base: "2億円", bull: "10億円" },
  { year: "2035", bear: "2億円", base: "20億円", bull: "100億円" }
];

// 課題と対策
const challenges = [
  {
    title: "24時間の制約",
    description: "PM/PdM案件は時間ありきのビジネスモデルであり、個人の稼働時間がボトルネック。営業してもスケールしない構造的課題。",
    solution: "情報収集→コンテンツ→教育→M&Aの自動化サイクルを構築し、時間に依存しない収益モデルを確立。"
  },
  {
    title: "新規事業への投資時間不足",
    description: "現金調達案件（週40-44時間程度）でリソースがカツカツ。新規事業を育てる時間が確保できていない。",
    solution: "時間配分ルールを厳格化し、Build（新規事業）に週15時間を最優先で確保。不足するならCash案件を削る。"
  },
  {
    title: "固定費の回収",
    description: "月額固定費約29万円が発生しているが、初年度は投資フェーズで赤字が継続。",
    solution: "2026年Q1から月50万円の売上目標を設定し、固定費を回収できる売上構造を構築。"
  }
];

// 意思決定の3本の柱
const decisionPillars = [
  {
    icon: "💪",
    title: "健康に邁進する",
    description: "持続可能な働き方を優先。週45時間の上限を設け、育児と仕事の両立を実現。"
  },
  {
    icon: "🔄",
    title: "複数事業の安定化",
    description: "個人事業・法人・新規事業の3事業体を稼働状態にして、当面のキャッシュと挑戦を両立。"
  },
  {
    icon: "🚀",
    title: "創業し新規事業に挑戦",
    description: "24時間の制約を超えるビジネスモデルを構築。自動化サイクルで持続的成長を目指す。"
  }
];
---

<Layout
  title="会社の取り組み | 2025年振り返りと2026年事業計画 | 株式会社TECMAH"
  description="株式会社TECMAHの2025年下半期振り返りと2026年事業計画。財務データ、成長戦略、中長期ロードマップを詳細にご報告します。"
>
  <main>
    <!-- Hero Section -->
    <PageHero
      titleHtml='<span class="gradient-text">2025年の歩みと</span><br /><span class="gradient-text">これからの挑戦</span>'
      subtitleHtml="設立6ヶ月の実績と、2026年以降の成長戦略を詳細にご報告いたします。"
      badge="Company Update 2025"
      badgeIconHtml={chartIcon}
    />

    <!-- 意思決定の3本の柱 -->
    <section class="section" id="pillars">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">Decision Pillars</span>
          <h2 class="section-title">意思決定の<span class="gradient-text">3本の柱</span></h2>
          <p class="section-description">
            2025年の行動原理として、以下の3つの柱を中心に意思決定を行ってまいりました。
          </p>
        </div>

        <div class="pillars-grid">
          {decisionPillars.map((pillar, index) => (
            <div class="pillar-card scroll-fade-up" style={`--delay: ${index * 0.15}s`}>
              <div class="pillar-icon">{pillar.icon}</div>
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-description">{pillar.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 沿革タイムライン -->
    <section class="section section-alt" id="milestones">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">2025 Milestones</span>
          <h2 class="section-title">2025年<span class="gradient-text">沿革</span></h2>
          <p class="section-description">
            設立から6ヶ月間の主要なマイルストーンをご報告いたします。
          </p>
        </div>

        <div class="timeline">
          {milestones2025.map((milestone, index) => (
            <div class={`timeline-item ${milestone.type} scroll-fade-up`} style={`--delay: ${index * 0.1}s`}>
              <div class="timeline-marker">
                <div class="marker-dot"></div>
                {index < milestones2025.length - 1 && <div class="marker-line"></div>}
              </div>
              <div class="timeline-content">
                <span class="timeline-date">{milestone.date}</span>
                <h3 class="timeline-title">{milestone.title}</h3>
                <p class="timeline-description">{milestone.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 財務詳細 -->
    <section class="section" id="financials">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">Financial Details</span>
          <h2 class="section-title">財務<span class="gradient-text">詳細</span></h2>
          <p class="section-description">
            {financialData.period}の財務状況を詳細にご報告いたします。
          </p>
        </div>

        <div class="financial-sections">
          <!-- 売上 -->
          <div class="financial-section scroll-fade-up" style="--delay: 0.1s">
            <div class="financial-section-header">
              <h3>売上高</h3>
              <div class="financial-section-value">{financialData.revenue.total}<span class="note">{financialData.revenue.note}</span></div>
            </div>
            <div class="financial-breakdown">
              {financialData.revenue.breakdown.map((item) => (
                <div class="breakdown-item">
                  <span class="breakdown-label">{item.label}</span>
                  <span class="breakdown-value">{item.value}</span>
                  <span class="breakdown-note">{item.note}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- 固定費 -->
          <div class="financial-section scroll-fade-up" style="--delay: 0.2s">
            <div class="financial-section-header">
              <h3>固定費</h3>
              <div class="financial-section-value">{financialData.expenses.monthly}<span class="note">/月</span></div>
            </div>
            <div class="financial-breakdown">
              {financialData.expenses.breakdown.map((item) => (
                <div class="breakdown-item">
                  <span class="breakdown-label">{item.label}</span>
                  <span class="breakdown-value">{item.value}</span>
                </div>
              ))}
            </div>
            <div class="breakdown-total">
              <span>期間合計（7-10月）</span>
              <span>{financialData.expenses.total}</span>
            </div>
          </div>

          <!-- 資金調達 -->
          <div class="financial-section scroll-fade-up" style="--delay: 0.3s">
            <div class="financial-section-header">
              <h3>資金調達</h3>
              <div class="financial-section-value">300万円<span class="note">（自己資本+借入）</span></div>
            </div>
            <div class="financial-breakdown">
              <div class="breakdown-item">
                <span class="breakdown-label">資本金（自己資本）</span>
                <span class="breakdown-value">{financialData.capital.equity}</span>
              </div>
              <div class="breakdown-item">
                <span class="breakdown-label">長期借入金</span>
                <span class="breakdown-value">{financialData.capital.debt}</span>
                <span class="breakdown-note">{financialData.capital.debtSource}</span>
              </div>
            </div>
          </div>

          <!-- 現金残高 -->
          <div class="financial-section scroll-fade-up" style="--delay: 0.4s">
            <div class="financial-section-header">
              <h3>現金残高</h3>
              <div class="financial-section-value">{financialData.cash.current}<span class="note">{financialData.cash.note}</span></div>
            </div>
            <div class="financial-forecast">
              <div class="forecast-item">
                <span class="forecast-label">12月末見通し</span>
                <span class="forecast-value">{financialData.cash.forecast}</span>
              </div>
              <p class="forecast-note">
                ※ 11-12月の予定入金（132.3万円）を反映した見通し
              </p>
            </div>
          </div>
        </div>

        <div class="financial-note scroll-fade-in">
          <h4>📝 初年度の位置づけ</h4>
          <p>
            当社は2025年7月に設立された未上場企業です。第1期（2025年7月〜2026年6月）は<strong>基盤構築期</strong>として、
            収益構造の確立と新規事業への投資を優先しております。7-10月は売上0円の状態が続きましたが、
            9月に初の法人案件を決定し、10月より稼働を開始いたしました。
          </p>
        </div>
      </div>
    </section>

    <!-- 案件詳細 -->
    <section class="section section-alt" id="project">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">Project Details</span>
          <h2 class="section-title">主要案件<span class="gradient-text">詳細</span></h2>
        </div>

        <div class="project-card scroll-fade-up">
          <div class="project-header">
            <div class="project-badge">法人案件</div>
            <h3 class="project-name">{projectDetails.name}</h3>
          </div>
          <div class="project-content">
            <div class="project-info">
              <div class="info-item">
                <span class="info-label">役割</span>
                <span class="info-value">{projectDetails.role}</span>
              </div>
              <div class="info-item">
                <span class="info-label">業務内容</span>
                <span class="info-value">{projectDetails.description}</span>
              </div>
              <div class="info-item">
                <span class="info-label">時間単価</span>
                <span class="info-value">{projectDetails.hourlyRate}</span>
              </div>
              <div class="info-item">
                <span class="info-label">獲得チャネル</span>
                <span class="info-value">{projectDetails.channel}</span>
              </div>
            </div>
            <div class="project-workload">
              <h4>稼働実績</h4>
              <div class="workload-items">
                {projectDetails.workload.map((item) => (
                  <div class="workload-item">
                    <span class="workload-month">{item.month}</span>
                    <span class="workload-hours">{item.hours}</span>
                    <span class="workload-note">{item.note}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2026年目標 -->
    <section class="section" id="targets">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">2026 Targets</span>
          <h2 class="section-title">2026年度<span class="gradient-text">事業目標</span></h2>
        </div>

        <div class="targets-overview scroll-fade-up">
          <div class="target-card primary">
            <div class="target-label">年間売上目標</div>
            <div class="target-value">{targets2026.revenue.annual}</div>
            <div class="target-sub">月次 {targets2026.revenue.monthly}</div>
          </div>
          <div class="target-card">
            <div class="target-label">年間利益目標</div>
            <div class="target-value">{targets2026.profit.annual}</div>
            <div class="target-sub">月次 {targets2026.profit.monthly}</div>
          </div>
          <div class="target-card">
            <div class="target-label">固定費（Q1-Q2）</div>
            <div class="target-value">{targets2026.expenses.q1q2}</div>
            <div class="target-sub">Q3-Q4: {targets2026.expenses.q3q4}</div>
          </div>
        </div>

        <div class="quarterly-targets scroll-fade-up" style="--delay: 0.2s">
          <h3>四半期別目標</h3>
          <div class="quarterly-grid">
            {targets2026.quarterly.map((q) => (
              <div class="quarterly-item">
                <div class="quarterly-header">{q.quarter}</div>
                <div class="quarterly-values">
                  <div class="quarterly-value">
                    <span class="label">売上</span>
                    <span class="value">{q.revenue}</span>
                  </div>
                  <div class="quarterly-value">
                    <span class="label">利益</span>
                    <span class="value">{q.profit}</span>
                  </div>
                </div>
                <p class="quarterly-note">{q.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 時間配分ルール -->
    <section class="section section-alt" id="time-allocation">
      <div class="container">
        <div class="section-header scroll-fade-in">
          <span class="section-badge">Time Allocation</span>
          <h2 class="section-title">時間配分<span class="gradient-text">ルール</span></h2>
          <p class="section-description">
            週の総稼働上限を<strong>{timeAllocation.maxWeekly}</strong>と定め、以下のカテゴリに配分します。
          </p>
        </div>

