---
// =====================================================================
// 電子公告ページ（法定公告の入口）
//
// 登記した公告URL（https://www.tecmah.com）→ フッター「電子公告」→ 本ページ（/koukoku）→ 各公告ページ
// が会社法上の公告到達導線。投資家向け情報（/ir）や代表者の経歴（/profile）とは切り離し、
// 法定公告のみを掲載する。営業的な CTA は置かない。
//
// - 本ページの URL（/koukoku）は掲載中の公告がある限り変更しない
// - 公告データは src/data/koukoku.ts で管理する
// - scripts/verify-koukoku.mjs がビルド後に導線を検証する
// =====================================================================
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { company, pageMeta } from "../data/content";
import { koukokuMethod, kessanNotices, otherNotices } from "../data/koukoku";

const { title: pageTitle, description: pageDescription } = pageMeta.koukoku;

const koukokuIcon = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main>
    <PageHero
      titleHtml='<span class="gradient-text">電子公告</span>'
      subtitleHtml={`${company.name}の法定公告を掲載しています。<br /><span class='text-muted'>当社は定款の定めにより、公告を電子公告の方法で行います。</span>`}
      badge="法定公告"
      badgeIconHtml={koukokuIcon}
    />

    <!-- 公告方法 -->
    <section class="section section-alt">
      <div class="container">
        <div class="notice-card">
          <h2 class="notice-title">公告に関する事項</h2>
          <table class="notice-table">
            <tbody>
              <tr>
                <th scope="row">商号</th>
                <td>{company.name}</td>
              </tr>
              <tr>
                <th scope="row">本店所在地</th>
                <td>{company.address.full}</td>
              </tr>
              <tr>
                <th scope="row">代表取締役</th>
                <td>{company.representative}</td>
              </tr>
              <tr>
                <th scope="row">公告方法</th>
                <td>{koukokuMethod.method}（{koukokuMethod.legalBasis}）</td>
              </tr>
              <tr>
                <th scope="row">掲載URL</th>
                <td>
                  <a href="/koukoku" class="link">{koukokuMethod.pageUrl}</a>
                </td>
              </tr>
              <tr>
                <th scope="row">お問い合わせ</th>
                <td><a href={`mailto:${company.contact.email}`} class="link">{company.contact.email}</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 決算公告 -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <span class="gradient-text">決算公告</span>
          </h2>
          <p class="section-description">
            会社法第440条第1項に基づき、定時株主総会の承認を受けた貸借対照表を公告しています。<br />
            <span class="text-muted">各公告は、定時株主総会の終結の日後5年を経過する日まで継続して掲載します（{koukokuMethod.kessanPeriodBasis}）。</span>
          </p>
        </div>

        {kessanNotices.length > 0 ? (
          <div class="notice-list">
            {kessanNotices.map((notice) => (
              <a href={notice.href} class="notice-item">
                <div class="notice-item-body">
                  <span class="notice-kind">{notice.kind}</span>
                  <h3 class="notice-item-title">{notice.title}</h3>
                  <dl class="notice-item-meta">
                    {notice.period && (
                      <div>
                        <dt>対象期間</dt>
                        <dd>{notice.period}</dd>
                      </div>
                    )}
                    <div>
                      <dt>公告日</dt>
                      <dd>{notice.publishDate}</dd>
                    </div>
                    <div>
                      <dt>掲載期間</dt>
                      <dd>{notice.publishDate}〜{notice.publicationEndDate}</dd>
                    </div>
                    <div>
                      <dt>根拠条文</dt>
                      <dd>{notice.legalBasis}</dd>
                    </div>
                  </dl>
                </div>
                <span class="notice-item-action">
                  公告を見る
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="notice-empty">現在、掲載中の決算公告はありません。</p>
        )}
      </div>
    </section>

    <!-- その他の公告 -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">
            <span class="gradient-text">その他の公告</span>
          </h2>
        </div>

        {otherNotices.length > 0 ? (
          <div class="notice-list">
            {otherNotices.map((notice) => (
              <a href={notice.href} class="notice-item">
                <div class="notice-item-body">
                  <span class="notice-kind">{notice.kind}</span>
                  <h3 class="notice-item-title">{notice.title}</h3>
                  <dl class="notice-item-meta">
                    <div>
                      <dt>公告日</dt>
                      <dd>{notice.publishDate}</dd>
                    </div>
                    <div>
                      <dt>掲載期間</dt>
                      <dd>{notice.publishDate}〜{notice.publicationEndDate}</dd>
                    </div>
                    <div>
                      <dt>根拠条文</dt>
                      <dd>{notice.legalBasis}</dd>
                    </div>
                  </dl>
                </div>
                <span class="notice-item-action">
                  公告を見る
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="notice-empty">現在、掲載中の公告はありません。</p>
        )}
      </div>
    </section>

    <!-- 電子公告について -->
    <section class="section">
      <div class="container">
        <div class="notes-card">
          <h2 class="notes-title">電子公告について</h2>
          <ul class="notes-list">
            <li>当社は、定款の定めにより、公告方法を電子公告としています（会社法第939条第1項第3号）。公告は当社ウェブサイト（<a href="/" class="link">{koukokuMethod.siteUrl}</a>）に掲載します。</li>
            <li>決算公告（会社法第440条第1項）は、貸借対照表の全文を掲載し、定時株主総会の終結の日後5年を経過する日まで継続して掲載します（会社法第940条第1項第2号）。</li>
            <li>公告ページのURLは、掲載期間中は変更しません。サイト構成を変更する場合も、公告ページには従前のURLからアクセスできるようにします。</li>
            <li>投資家向け情報（業績ハイライト・お知らせ等）および期中の参考資料は法定公告ではありません。<a href="/ir" class="link">投資家向け情報（IR）</a>をご覧ください。</li>
            <li>本公告に関するお問い合わせは、<a href={`mailto:${company.contact.email}`} class="link">{company.contact.email}</a> までご連絡ください。</li>
          </ul>
        </div>

        <nav class="related-links" aria-label="関連ページ">
          <a href="/ir" class="related-link">投資家向け情報（IR）</a>
          <a href="/about" class="related-link">会社概要</a>
        </nav>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* 公告に関する事項 */
  .notice-card {
    max-width: 48rem;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2rem;
  }

  .notice-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
  }

  .notice-table {
    width: 100%;
    border-collapse: collapse;
  }

  .notice-table tr {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .notice-table th {
    flex-shrink: 0;
    width: 120px;
    font-weight: 600;
    color: var(--primary);
    text-align: left;
  }

  .notice-table td {
    color: var(--text);
    word-break: break-all;
  }

  /* 公告一覧 */
  .notice-list {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .notice-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 2rem;
    text-decoration: none;
    transition: border-color var(--motion-duration) var(--motion-ease),
      transform var(--motion-duration) var(--motion-ease);
  }

  .notice-item:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .notice-item-body {
    flex: 1;
    min-width: 0;
  }

  .notice-kind {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    background: rgba(0, 212, 170, 0.1);
    border: 1px solid rgba(0, 212, 170, 0.3);
    border-radius: var(--radius-full);
    padding: 0.125rem 0.75rem;
    margin-bottom: 0.5rem;
  }

  .notice-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .notice-item-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem 1.5rem;
    margin: 0;
  }

  .notice-item-meta div {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .notice-item-meta dt {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .notice-item-meta dd {
    color: var(--text-secondary);
    margin: 0;
  }

  .notice-item-action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--primary);
    font-weight: 600;
    white-space: nowrap;
  }

  .notice-item-action svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .notice-empty {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
    color: var(--text-muted);
  }

  /* 電子公告について */
  .notes-card {
    max-width: 48rem;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 2rem;
  }

  .notes-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 0.75rem;
  }

  .notes-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
  }

  .link {
    color: var(--primary);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  /* 関連ページ */
  .related-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .related-link {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }

  .related-link:hover {
    text-decoration: underline;
  }

  .text-muted {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .notice-table tr {
      flex-direction: column;
      gap: 0.25rem;
    }

    .notice-table th {
      width: auto;
    }

    .notice-item {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem 1.5rem;
    }

    .notice-item-meta {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice-item {
      transition: none;
    }

    .notice-item:hover {
      transform: none;
    }
  }
</style>
